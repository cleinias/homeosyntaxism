# homeosyntax — API keys for the cloud backends.
# Copy to `.env` (git-ignored) and fill in only the keys you need.
# The scripts parse this file directly (plain KEY=value lines); python-dotenv also works.

# Claude — used by `--backend anthropic` (generation) AND by score_production.py
# (the frame-divergence + coherence LLM-judges), regardless of which backend generated.
ANTHROPIC_API_KEY=

# OpenRouter — used by `--backend openrouter` for the open-weight models
# (Qwen, Kimi, …); routing is provider/quant-pinned — see MANIFEST.md.
OPENROUTER_API_KEY=

# Optional: override the judge model used by score_production.py / sem_metrics.py
# (default: claude-sonnet-4-6).
# SEM_JUDGE_MODEL=claude-opus-4-8
